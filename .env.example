# ============================================================================
# Command Hub — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Discord -----------------------------------------------------------------
# Discord application bot token. Requires the MESSAGE CONTENT intent enabled
# in the Discord Developer Portal (Bot tab -> Privileged Gateway Intents).
DISCORD_BOT_TOKEN=

# The Discord server (guild) id the bot operates in. Optional but recommended:
# scopes slash-command sync to this one guild for instant updates.
DISCORD_GUILD_ID=

# --- People (captured during Phase 0 provisioning) ---------------------------
# Enable Developer Mode in Discord, right-click a user -> Copy User ID.
OWNER_DISCORD_USER_ID=
PARTNER_DISCORD_USER_ID=
PARTNER_DISPLAY_NAME=

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role bypasses RLS. Lives ONLY on the trusted hub device. Never ship
# this to any browser/client surface.
SUPABASE_SERVICE_ROLE_KEY=

# --- Agent (Claude Code, subscription-authed) --------------------------------
# CRITICAL GUARDRAIL: ANTHROPIC_API_KEY must be UNSET so Claude Code draws from
# the Max subscription, not billed API usage. The startup guard fails loudly if
# it is present. Do NOT add it here.
#
# How the bot invokes the agent: "cli" runs `claude -p` headless; "sdk" uses the
# Python Claude Agent SDK. Both use subscription auth.
AGENT_MODE=cli
# Path to the claude executable (if not on PATH).
CLAUDE_BIN=claude

# --- Scheduler / locale ------------------------------------------------------
# Phoenix is MST year-round (no DST). Change if the hub lives elsewhere.
TIMEZONE=America/Phoenix

# Daily briefing time (24h, hub local time).
BRIEFING_TIME=07:00
# Weekly recap day/time (0=Mon ... 6=Sun).
WEEKLY_RECAP_DOW=6
WEEKLY_RECAP_TIME=18:00

# Minutes after a block ends before an unanswered close-out is logged "unclosed".
CLOSEOUT_GRACE_MIN=15
# Nightly time to nudge for unclosed-block backfill.
NIGHTLY_NUDGE_TIME=21:00

# --- Dashboard ---------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
# Optional shared secret to gate the admin dashboard on the LAN.
DASHBOARD_SECRET=

# --- Hub device --------------------------------------------------------------
# linux | macos | windows  (decides the process manager in deploy/)
HUB_OS=linux

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
