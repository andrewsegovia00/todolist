<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS (launchd) agent for the Command Hub bot.
     Install:
       cp deploy/launchd/com.commandhub.bot.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.commandhub.bot.plist
     Edit the paths (replace "andrew" with your macOS username) to match the hub.
     Do NOT put ANTHROPIC_API_KEY in here.

     The process is wrapped in `caffeinate -i` so the Mac won't idle-sleep the
     hub out from under the scheduler — block reminders/close-outs only fire if
     the machine is awake. caffeinate holds the assertion for as long as the bot
     runs and releases it if the bot exits. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.commandhub.bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/Users/andrew/command-hub/.venv/bin/python</string>
    <string>-m</string>
    <string>bot.main</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/andrew/command-hub</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/andrew/command-hub/logs/bot.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/andrew/command-hub/logs/bot.err.log</string>
</dict>
</plist>
